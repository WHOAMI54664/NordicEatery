{
  "name": "mikes-food",
  "version": "0.1.0",
  "private": true,
  "description": "Website for ordering Polish street food: Maczanka Krakowska and Knysza.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WHOAMI54664/NordicEatery.git"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit --incremental false",
    "translate": "tsx scripts/translate.ts",
    "typecheck:swish": "tsc --noEmit --esModuleInterop --skipLibCheck --target ES2020 --module NodeNext --moduleResolution NodeNext src/server.ts src/swish-group.ts src/swish-verification.ts"
  },
  "dependencies": {
    "@formatjs/icu-messageformat-parser": "3.5.5",
    "@lottiefiles/dotlottie-react": "^0.19.2",
